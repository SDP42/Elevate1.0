# Copy this file to .env and fill in real values — see db/SETUP.md.

# Connection string for your Neon / Vercel Postgres database.
DATABASE_URL=

# Any long random string — used to sign login session cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Private Wi-Fi access for ELEV01–ELEV32. Server-only; never use a VITE_ prefix.
# ElevateN is mapped from the existing ELEVNN team code. Website logins stay unchanged.
PARTNER_ACCESS_LABEL="Wi-Fi access"
PARTNER_ACCESS_PASSWORD=
